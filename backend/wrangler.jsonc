{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plane-display-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-26",
  "assets": { "directory": "public", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "plane-display", "database_id": "REPLACE_AFTER_CREATING_D1" }
  ]
}
